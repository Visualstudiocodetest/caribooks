%% Architecture en couches (Clean Architecture) — Backend FastAPI
flowchart TB
    pres["<b>Présentation (Routers)</b><br/>auth · book · catalog · article · order · order_admin · payment · scan · user · stock · images"]
    svc["<b>Services (Métier)</b><br/>jwt_service · order_service · postfinance_service · book_service · image_service · rate_limit"]
    infra["<b>Infrastructure (Données)</b><br/>SQLAlchemy models · crud_base · crud_user · crud_book · db.py"]

    pres -.->|dépend de| svc
    svc -.->|dépend de| infra

    classDef pres fill:#d6f0f5,stroke:#0d6b7d;
    classDef svc fill:#cfe2ff,stroke:#0d3b66;
    classDef infra fill:#ffe3c2,stroke:#9a5b0a;
    class pres pres;
    class svc svc;
    class infra infra;
