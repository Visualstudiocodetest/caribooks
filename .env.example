# ==========================
# Application configuration
# ==========================
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=          # MySQL private IP (example: 10.0.1.10)
MYSQL_DB=

SECRET_KEY=          # strong secret (do NOT commit)
ENVIRONMENT=production

# PostFinance configuration
POSTFINANCE_USER_ID=
POSTFINANCE_AUTH_KEY=
POSTFINANCE_SPACE_ID=
POSTFINANCE_WEBHOOK_PUBLIC_KEY_PEM=
POSTFINANCE_WEBHOOK_KEY_ID=
POSTFINANCE_BASE_URL=https://checkout.postfinance.ch/api


# Frontend URLs
FRONTEND_BASE_URL=https://your-project.vercel.app
NEXT_PUBLIC_BACKEND_BASE_URL=https://api.yourdomain.com

# ==========================
# Deployment helpers (fill before running GH Actions)
# These are examples only — store secrets in GitHub Secrets when possible
# ==========================
VM1_PUBLIC_IP=       # public IP of fastapi-vm1
VM2_PUBLIC_IP=       # public IP of fastapi-vm2
VM1_PRIVATE_IP=      # private IP of fastapi-vm1 (10.0.0.x)
VM2_PRIVATE_IP=      # private IP of fastapi-vm2 (10.0.0.y)
LOAD_BALANCER_IP=    # Load Balancer public IP (if configured)

SSH_USER=ubuntu
# The SSH key should be added as a GitHub Secret (SSH_PRIVATE_KEY) and NOT committed here.
SSH_PRIVATE_KEY_PLACEHOLDER=

# GitHub Actions secret names you will need to create:
# - VM1_PUBLIC_IP
# - VM2_PUBLIC_IP
# - SSH_PRIVATE_KEY
# - SSH_USER (optional)

#