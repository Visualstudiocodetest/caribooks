# FastAPI base URL used by Next.js server-side fetches
BACKEND_BASE_URL=http://localhost:8000

# FastAPI base URL used by the browser (client-side). Requires CORS enabled in FastAPI.
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8000

# Google OAuth — Client ID from Google Cloud Console (OAuth 2.0 Web application)
# Used for "Sign in with Google" on login/register pages
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
