#!/bin/bash
# Auto-push on real commits, replacing the old polling daemons
# (overleaf-sync-daemon.sh / ~/overleaf-caribooks/sync-to-overleaf.sh) that
# invented an "Autosync" commit every few seconds even with no real change.
#
# This only runs when you actually commit (from VS Code or the CLI), and
# only on main -- feature branches are left alone so WIP work never gets
# auto-pushed anywhere.
#
# Installed via: git config core.hooksPath scripts/git-hooks
# Pause any time with:   touch .git/no-autopush
# Resume with:            rm .git/no-autopush

cd "$(git rev-parse --show-toplevel)" || exit 0
LOGFILE=".git/autopush.log"
log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOGFILE"; }

[ -f ".git/no-autopush" ] && exit 0

branch="$(git symbolic-ref --short HEAD 2>/dev/null)"
[ "$branch" != "main" ] && exit 0

if git push origin main --quiet 2>>"$LOGFILE"; then
  log "pushed main to origin (GitHub)"
  echo "[post-commit] pushed to GitHub"
else
  log "push to origin FAILED"
  echo "[post-commit] push to GitHub failed -- see .git/autopush.log"
fi

if git push overleaf main:main --quiet 2>>"$LOGFILE"; then
  log "pushed main to overleaf"
  echo "[post-commit] pushed to Overleaf"
else
  log "push to overleaf FAILED (diverged? Overleaf web edits pending?)"
  echo "[post-commit] push to Overleaf failed -- run: git fetch overleaf && git merge overleaf/main"
fi
