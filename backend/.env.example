MYSQL_USER=MYSQL_USER
MYSQL_PASSWORD=MYSQL_PASSWORD
MYSQL_HOST=MYSQL_HOST_NAME
MYSQL_DB=MYSQL_DB_NAME

# App configuration
SECRET_KEY=dev-secret-key
ENVIRONMENT=development

# CORS / Frontend
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google OAuth — server-side audience validation (picked based on ENVIRONMENT)
DEV_GOOGLE_OAUTH_CLIENT_ID=
PROD_GOOGLE_OAUTH_CLIENT_ID=

# PostFinance configuration
POSTFINANCE_USER_ID=
POSTFINANCE_AUTH_KEY=
POSTFINANCE_SPACE_ID=
# PEM-encoded public key used to verify webhook signatures
POSTFINANCE_WEBHOOK_PUBLIC_KEY_PEM=
# Optional key identifier from the x-signature header
POSTFINANCE_WEBHOOK_KEY_ID=
POSTFINANCE_BASE_URL=https://checkout.postfinance.ch/api
